# ==============================================================================
# Ward 16 Heritage Backend Environment Variables
# ==============================================================================

# Backend Express Server Port (Runs on port 5001 to avoid macOS AirPlay on 5000)
PORT=5001
NODE_ENV=development

# Traditional PostgreSQL Connection
# Either full DATABASE_URL or individual PG* variables:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ward16_heritage

# Or individual parameters:
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=ward16_heritage

# Allowed Frontend URL for CORS (Next.js frontend runs on port 3000)
FRONTEND_URL=http://localhost:3000
